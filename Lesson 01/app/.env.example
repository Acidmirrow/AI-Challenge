# ============================================================================
#  Этот файл нужен только docker compose — здесь порты на хосте.
#  Конфигурация приложения живёт в config/app.properties,
#  секреты (токены) — в config/secrets.properties (gitignored, монтируется).
# ============================================================================
API_PORT=8000
FRONT_PORT=8501

# ---------------------------------------------------------------------------
# Альтернатива: переопределение через переменные окружения контейнера.
# Они имеют приоритет над properties-файлами. Задавать так:
#   docker compose run --rm -e PROVIDER=openai -e OPENAI_API_KEY=sk-... api
# ---------------------------------------------------------------------------
# PROVIDER=openai
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# --- Провайдер -----------------------------------------------------------------
# mock     — офлайн-демо, ключ не нужен
# openai   — любой OpenAI-совместимый endpoint (OpenAI, OpenRouter, vLLM, LM Studio, Ollama /v1)
# deepseek — нативный DeepSeek API: каталог deepseek-flash / deepseek-v4-pro
PROVIDER=mock

# Ключ OpenAI-совместимого провайдера. Заполни и НЕ коммить .env (он в .gitignore).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ключ DeepSeek (используется при PROVIDER=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Имя параметра глубины рассуждений: reasoning_effort; "" — не отправлять
REASONING_PARAM=reasoning_effort
# "" — авто (max_completion_tokens для reasoning-моделей, иначе max_tokens)
MAX_TOKENS_PARAM=
INCLUDE_USAGE=true

# Свой каталог моделей (путь внутри контейнера /srv): JSON-массив объектов
# [{"id": "...", "label": "...", "reasoning_levels": ["low","high"], "supports_temperature": true}]
MODELS_JSON=
# Подтягивать модели из <base_url>/models в дополнение к каталогу
DYNAMIC_MODELS=false

# --- Веб-поиск для модели ------------------------------------------------------
# off | auto | duckduckgo | brave-html | brave-api | tavily
# auto: ключевые API (если заданы) → DuckDuckGo → Brave HTML
WEB_SEARCH_BACKEND=auto
# Ключи опциональны: без них работает keyless DuckDuckGo
TAVILY_API_KEY=
BRAVE_API_KEY=
# Сколько результатов отдавать модели, сколько страниц читать и сколько символов брать
WEB_SEARCH_RESULTS=5
WEB_SEARCH_PAGES=2
WEB_SEARCH_PAGE_CHARS=3000

# Порты на хосте
API_PORT=8000
FRONT_PORT=8501

# --- Провайдер -----------------------------------------------------------------
# mock   — офлайн-демо, ключ не нужен
# openai — любой OpenAI-совместимый endpoint (OpenAI, OpenRouter, DeepSeek, vLLM, LM Studio)
PROVIDER=mock

# Ключ. Для PROVIDER=openai заполни и НЕ коммить этот файл (.env в .gitignore).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Язык размышлений: reasoning_effort (OpenAI), "" — не отправлять параметр
REASONING_PARAM=reasoning_effort
# "" — авто (max_completion_tokens для reasoning-моделей, иначе max_tokens)
MAX_TOKENS_PARAM=
INCLUDE_USAGE=true

# Свой список моделей (путь внутри контейнера /srv): JSON-массив объектов
# [{"id": "...", "label": "...", "supports_reasoning": true, "supports_temperature": false}]
MODELS_JSON=
# Подтягивать модели из <OPENAI_BASE_URL>/models
DYNAMIC_MODELS=false

# Порты на хосте
API_PORT=8000
FRONT_PORT=8501
